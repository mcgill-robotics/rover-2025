# Tony's Arm Systemd File 
# Hello, this file will run the CAN <-> MQTT bridge on the raspberry pi on boot-up
#
# TO INSTALL ON THE PI: (untested as of November 25 2026)
# sudo cp arm-can-bridge.service /etc/systemd/system
# ^ This line copies the service file into the magical raspberry pi location where it runs
# sudo systemctl daemon-reload
# ^ This above line reloads the daemon configuration
# sudo systemctl enable --now arm-can-bridge
# ^ This above line turns the service on now

# TO SEE IF IT'S RUNNING:
#   systemctl status arm-can-bridge
#
# PREREQUISITE: Install Mosquitto on the Pi, run uv sync in the embedded repo bridge
# package such that the arm-can-bridge process becomes available.
# Also! The user must be added to the dialout group i.e. the user group that can use serial ports.

[Unit]
Description=Arm CAN <-> MQTT bridge
# Make sure the Mosquitto broker starts first
After=mosquitto.service
Wants=mosquitto.service
# New name needed! Not sure if this one is permanent!
BindsTo=dev-ttyACM0.device
# Bottlenecked by this device if it doesn't show up :/
After=dev-ttyACM0.device

[Service]
# Not 100% sure if this is correct, check with `whoami` on the Pi.
User=pi
# This below line depends on the script being there yknow (uv sync in bridge/)
ExecStart=/home/pi/rover-embedded-2027/bridge/.venv/bin/arm-can-bridge
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
